# Firebase Functions Environment Variables
# Set these in functions/.env file

# Admin credentials (passwords must be bcrypt hashes)
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',10).then(h=>console.log(h))"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Employee credentials (comma-separated, format: email:bcryptHash:DisplayName)
# Example: john@company.com:$2a$10$xxxx:John Doe,jane@company.com:$2a$10$yyyy:Jane Smith
EMPLOYEE_CREDENTIALS=

# JWT signing secret (any random string)
JWT_SECRET=
